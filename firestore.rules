rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Bootstrap the first admin manually in Firebase Console:
    // users/{UID} -> role: "admin". Users cannot change their own role.
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == "user";
      allow update: if isAdmin() ||
        (isOwner(uid) &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /likes/{likeId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        likeId == request.resource.data.videoId + "_" + request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid || isAdmin();
      allow update: if false;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 1500;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid || isAdmin();
    }

    match /savedVideos/{saveId} {
      allow read, delete: if signedIn() &&
        resource.data.userId == request.auth.uid || isAdmin();
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        saveId == request.auth.uid + "_" + request.resource.data.videoId;
      allow update: if false;
    }

    match /appSettings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}